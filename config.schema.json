{
  "pluginAlias": "SharkIQ",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "customUiPath": "./dist/homebridge-ui",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "SharkIQ"
      },
      "email": {
        "title": "SharkClean Account Email",
        "type": "string",
        "required": false
      },
      "password": {
        "title": "SharkClean Account Password",
        "type": "string",
        "required": false
      },
      "oAuthCode": {
        "title": "SharkClean OAuth Code",
        "type": "string",
        "required": false
      },
      "vacuums": {
        "title": "SharkClean Vacuum Devicess",
        "type": "array",
        "required": true,
        "items": {
          "title": "SharkClean DSN",
          "type": "string"
        }
      },
      "europe": {
        "title": "SharkClean European Server",
        "type": "boolean",
        "required": false,
        "default": false
      },
      "invertDockedStatus": {
        "title": "Invert Vacuum Docked Status",
        "type": "boolean",
        "required": false,
        "default": false
      },
      "dockedUpdateInterval": {
        "title": "Docked Update Interval",
        "type": "integer",
        "required": false,
        "default": 30000
      },
      "enhancedVacuumMode": {
        "title": "Enhanced Vacuum Mode",
        "type": "boolean",
        "required": false,
        "default": true,
        "description": "Use improved power level mappings and vacuum-optimized behavior. Prepares for future robot vacuum service support."
      }
    }
  },
  "layout": [
    {
      "type": "fieldset",
      "title": "SharkIQ Account Info",
      "expandable": true,
      "expanded": true,
      "items": [
        "email",
        "password"
      ]
    },
    {
      "type": "fieldset",
      "title": "SharkIQ OAuth Info",
      "expandable": true,
      "expanded": false,
      "items": [
        {
          "type": "help",
          "helpvalue": "<h5>OAuth Code</h5><em class='primary-text'>Enter the OAuth code you received from SharkClean. This is used for manually obtaining credentials.</em>"
        },
        "oAuthCode"
      ]
    },
    {
      "type": "fieldset",
      "title": "Vacuum Settings",
      "expandable": true,
      "expanded": true,
      "items": [
        {
          "type": "help",
          "helpvalue": "<h5>Vacuums</h5><em class='primary-text'>Enter SharkClean DSN(s) you want to add to HomeKit.</em>"
        },
        {
          "key": "vacuums",
          "notitle": true,
          "type": "tabarray",
          "title": "{{ 'New Vacuum' }}",
          "expandable": true,
          "expanded": false,
          "orderable": true,
          "items": [
            {
              "key": "vacuums[]",
              "title": "{{ value || 'New DSN' }}"
            }
          ]
        },
        "europe",
        "invertDockedStatus",
        "dockedUpdateInterval",
        {
          "type": "help",
          "helpvalue": "<h5>Enhanced Vacuum Mode</h5><em class='primary-text'>Enables improved vacuum behavior with better power level mappings (25%=Eco, 50%=Normal, 100%=Max). This prepares your setup for future native HomeKit robot vacuum support.</em>"
        },
        "enhancedVacuumMode"
      ]
    }
  ]
}
