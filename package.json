{
  "name": "@homebridge-plugins/homebridge-sharkiq",
  "displayName": "SharkIQ Plugin",
  "type": "module",
  "version": "2.0.0",
  "description": "A Homebridge plugin to connect your Shark Vacuum to homebridge.",
  "author": {
    "name": "Bubba8291",
    "url": "https://github.com/Bubba8291"
  },
  "license": "Apache-2.0",
  "maintainers": [
    "Bubba8291"
  ],
  "funding": {
    "type": "paypal",
    "url": "https://paypal.me/ggg8291"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homebridge-plugins/homebridge-sharkiq.git"
  },
  "bugs": {
    "url": "https://github.com/homebridge-plugins/homebridge-sharkiq/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "sharkiq"
  ],
  "main": "dist/index.js",
  "engines": {
    "homebridge": "^2.0.0-beta.52",
    "node": "^22 || ^24"
  },
  "scripts": {
    "check": "npm install && npm outdated",
    "lint": "eslint src/**/**.ts --max-warnings=0",
    "lint:fix": "eslint src/**/*.ts --fix",
    "watch": "npm run build && npm run plugin-ui && npm link && nodemon",
    "plugin-ui": "rsync ./src/homebridge-ui/public/index.html ./dist/homebridge-ui/public/",
    "build": "npm run clean && tsc && npm run plugin-ui",
    "prepublishOnly": "npm run lint && npm run build && npm run plugin-ui && npm run docs && npm run docs:lint",
    "postpublish": "npm run clean && npm ci",
    "clean": "shx rm -rf ./dist",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test-coverage": "npm run test -- --coverage",
    "docs": "typedoc",
    "docs:lint": "typedoc --emit none --treatWarningsAsErrors"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.1.2-beta.0",
    "node-fetch": "^3.3.2",
    "puppeteer": "^24.29.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@eslint/compat": "^2.0.0",
    "@eslint/eslintrc": "^3.3.1",
    "@types/aes-js": "^3.1.4",
    "@types/debug": "^4.1.12",
    "@types/fs-extra": "^11.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.1",
    "@types/semver": "^7.7.1",
    "@types/source-map-support": "^0.5.10",
    "@vitest/coverage-v8": "^4.0.10",
    "eslint": "^9.39.1",
    "eslint-plugin-format": "^1.0.2",
    "eslint-plugin-import": "^2.32.0",
    "homebridge": "^2.0.0-beta.52",
    "homebridge-config-ui-x": "5.10.0",
    "nodemon": "^3.1.11",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.10"
  }
}
